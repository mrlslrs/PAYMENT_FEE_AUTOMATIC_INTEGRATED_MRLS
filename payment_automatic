def corrigir_valores_zerados_e_recalcular_final(df_com_pagamento_calculado, coluna_base='valor'):
    print("Verificando valores zerados na coluna valor...")

    valor_numerico = F.col(coluna_base).cast('double')
    esta_zerado = F.coalesce(valor_numerico == 0.0, F.lit(False))

    qtd_linhas_zeradas = df_com_pagamento_calculado.filter(esta_zerado).count()
    print(f"Linhas com valor zerado: {qtd_linhas_zeradas}")

    df = df_com_pagamento_calculado.withColumn(
        coluna_base,
        F.when(~esta_zerado, F.col(coluna_base))
         .when(F.col('marca_id').isin(BRAND_IDS_ZERO), F.lit(0.0))
         .otherwise(F.col(coluna_base))
    )

    df = df.withColumn(
        'valor_final',
        F.when(F.col('pagamento_calculado') == 'Brand/Store Não Encontrado', F.lit('Brand/Store Não Encontrado'))
         .when(F.col('marca_id').isin(BRAND_IDS_ZERO), F.col('pagamento_calculado'))
         .otherwise(F.col(coluna_base) + F.col('pagamento_calculado'))
    )

    print(f"Recalculo concluido em {qtd_linhas_zeradas} linha(s).")
