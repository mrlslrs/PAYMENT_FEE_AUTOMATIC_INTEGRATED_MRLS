query_pagamentos_realizados = r"""
WITH base AS (
  SELECT
    pais,
    id,
    tarefa_id,
    pedido_id,
    status,
    detalhes_pagamento,
    tipo_transacao,
    criado_em,
    loja_id,
    usuario_id,
    responsavel_pagamento_nome AS processador,
    COALESCE(
      REGEXP_EXTRACT(detalhes_pagamento, r'tarefa:\s*([A-Za-z0-9\-]+)\s*na loja'),
      REGEXP_EXTRACT(detalhes_pagamento, r'referente ao pedido\s*([A-Za-z0-9\-]+)\s*no dia')
    ) AS order_payment_completo
  FROM
    `projeto.dataset.pagamentos_realizados`
  WHERE
    criado_em >= DATETIME_SUB(CURRENT_DATETIME(), INTERVAL 15 DAY)
    AND pais = 'BR'
    AND responsavel_pagamento_nome IS NOT NULL
    AND NOT REGEXP_CONTAINS(detalhes_pagamento, r'(?i)Bonificacao|Reembolso')
)
SELECT
    pais,
    id,
    tarefa_id,
    pedido_id,
    status,
    detalhes_pagamento,
    tipo_transacao,
    criado_em,
    loja_id,
    usuario_id,
    responsavel_pagamento_nome AS processador,
  NULLIF(REGEXP_REPLACE(pedido_id, r'[^0-9]', ''), '') AS pedido_id_somente_numeros,
  usuario_id,
  processador
FROM base
QUALIFY ROW_NUMBER() OVER (PARTITION BY id ORDER BY criado_em DESC) = 1
"""

df_pagamentos = (
    spark.read
    .format("bigquery")
    .option("viewsEnabled", "true")
    .option("query", query_pagamentos_realizados)
    .load()
)

print(f"Linhas retornadas de pagamentos: {df_pagamentos.count():,}")

df_pagamentos.show(3, truncate=False)



df_pagamentos = df_pagamentos.filter(
    (
        F.col("pedido_id").isNotNull()
        & (F.trim(F.col("pedido_id")) != "")
    )
    |
    (
        F.col("pedido_id_somente_numeros").isNotNull()
        & (F.trim(F.col("pedido_id_somente_numeros")) != "")
    )
)



def normalizar_id(col):
    valor = F.trim(col.cast("string"))
    valor = F.regexp_replace(valor, r"\.0$", "")
    return (
        F.when(col.isNull() | (valor == ""), F.lit(None))
        .otherwise(valor)
    )


def somente_numeros(col):
    valor = F.regexp_replace(normalizar_id(col), r"[^0-9]", "")
    return (
        F.when(valor == "", F.lit(None))
        .otherwise(valor)
    )


df_pedidos_norm = (
    df_pedidos
    .withColumn("pedido_id__norm", normalizar_id(F.col("pedido_id")))
    .withColumn("pedido_id_somente_numeros__norm", somente_numeros(F.col("pedido_id")))
    .withColumn("usuario_id__norm", normalizar_id(F.col("usuario_id")))
    .withColumn("pedido_id__chave", F.coalesce(F.col("pedido_id_somente_numeros__norm"), F.col("pedido_id__norm")))
)

df_pagamentos_norm = (
    df_pagamentos
    .withColumn("pedido_id__norm", normalizar_id(F.col("pedido_id")))
    .withColumn("pedido_id_somente_numeros__norm", somente_numeros(F.col("pedido_id")))
    .withColumn("usuario_id__norm", normalizar_id(F.col("usuario_id")))
    .withColumn("pedido_id__chave", F.coalesce(F.col("pedido_id_somente_numeros__norm"), F.col("pedido_id__norm")))
    .select(
        F.col("pedido_id__chave").alias("pedido_id__chave"),
        F.col("usuario_id__norm").alias("usuario_id__norm"),
        F.col("status").alias("pagamento_status"),
        F.col("criado_em").alias("pagamento_criado_em"),
        F.col("processador").alias("pagamento_processador"),
    )
)

window_pagamentos = (
    Window
    .partitionBy("pedido_id__chave", "usuario_id__norm")
    .orderBy(F.when(F.lower(F.col("pagamento_status")) == "paid", F.lit(1)).otherwise(F.lit(0)).desc())
)

df_pagamentos_lookup = (
    df_pagamentos_norm
    .filter(F.col("pedido_id__chave").isNotNull() & F.col("usuario_id__norm").isNotNull())
    .withColumn("_rn", F.row_number().over(window_pagamentos))
    .filter(F.col("_rn") == 1)
    .drop("_rn")
)

p = df_pedidos_norm.alias("p")
w = df_pagamentos_lookup.alias("w")

condicao_match = (
    (F.col("p.pedido_id__chave") == F.col("w.pedido_id__chave")) &
    (F.col("p.usuario_id__norm") == F.col("w.usuario_id__norm"))
)

df_resultado = p.join(w, on=condicao_match, how="left").drop(F.col("w.pedido_id__chave"), F.col("w.usuario_id__norm"))

df_resultado_pagamentos = df_resultado.withColumn(
    "payment_status_final",
    F.when(F.col("pagamento_status").isNotNull(), F.lit("paid")).otherwise(F.lit("pending")),
)

df_resultado_pagamentos.show(20, truncate=False)



