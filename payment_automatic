def _texto_ou_vazio(coluna):
    return F.when(F.col(coluna).isNull(), F.lit('')).otherwise(F.col(coluna).cast('string'))


def _data_yyyy_mm_dd_ou_vazio(coluna):
    bruto = F.col(coluna).cast('string')
    ja_no_padrao = bruto.rlike(r'^\d{4}-\d{2}-\d{2}')
    tem_barra = bruto.contains('/')
    partes = F.split(bruto, '/')
    dia = F.lpad(partes.getItem(0), 2, '0')
    mes = F.lpad(partes.getItem(1), 2, '0')
    ano = partes.getItem(2)
    reformatada = F.concat_ws('-', ano, mes, dia)
    return (
        F.when(F.col(coluna).isNull(), F.lit(''))
         .when(ja_no_padrao, bruto.substr(1, 10))
         .when(tem_barra & (F.size(partes) == 3), reformatada)
         .otherwise(bruto)
    )


def preparar_dados_colagem(df):
    return df.select(
        _data_yyyy_mm_dd_ou_vazio('data_modificacao_local').alias('data_modificacao_local'),
