def montar_corpo_email(texto_resumo, resumo_lojas):
    tabela_html = montar_tabela_html(resumo_lojas)
    texto_html = (
        texto_resumo
        .replace('@canal ', '')
        .replace(':alert:', '⚠️')
        .split('```')[0]  # remove o bloco de tabela em texto puro, ja que teremos a tabela HTML
        .replace('\n', '<br>')
    )
    return f"""
    <html>
      <body style="font-family:Arial,sans-serif;font-size:14px;">
        <p>{texto_html}</p>
        {tabela_html}
      </body>
    </html>
    """


def enviar_email_gmail(gmail_service, destinatarios, assunto, corpo_html):
    mensagem = MIMEMultipart('alternative')
    mensagem['To'] = ", ".join(destinatarios)
    mensagem['Subject'] = assunto
    mensagem.attach(MIMEText(corpo_html, 'html'))

    corpo_codificado = base64.urlsafe_b64encode(mensagem.as_bytes()).decode()
    resultado = gmail_service.users().messages().send(
        userId=REMETENTE, body={'raw': corpo_codificado}
    ).execute()
    print(f"E-mail enviado com sucesso. ID: {resultado['id']}")
    return resultado


def enviar_resumo_pagamentos_email(creds, texto_resumo, resumo_lojas, periodo_texto):
    gmail_service = build('gmail', 'v1', credentials=creds)
    assunto = f"Resumo de Pagamentos - {periodo_texto}"
    corpo_html = montar_corpo_email(texto_resumo, resumo_lojas)
    return enviar_email_gmail(gmail_service, DESTINATARIOS, assunto, corpo_html)



