def converter_e_extrair_data_brasil(df, coluna_origem, coluna_destino='data_pedido_brasil'):
    ts_bruto = F.col(coluna_origem).cast('timestamp')
    ts_utc = F.to_utc_timestamp(ts_bruto, TZ_ORIGEM_DADOS)
    ts_brasil = F.from_utc_timestamp(ts_utc, TZ_NEGOCIO)
    df = df.withColumn('_ts_brasil_tmp', ts_brasil)
    df = df.withColumn(coluna_destino, F.date_format(F.col('_ts_brasil_tmp'), 'yyyy-MM-dd'))
    return df.drop('_ts_brasil_tmp')


def listar_feriados_nacionais(ano_inicio, ano_fim):
    import holidays
    br_nacional = holidays.Brazil(years=range(ano_inicio, ano_fim + 1))
    return sorted(d.strftime('%Y-%m-%d') for d in br_nacional.keys())


def classificar_tipo_dia(df, coluna_data_origem, ano_inicio, ano_fim, spark, prefixo='data'):
    feriados = listar_feriados_nacionais(ano_inicio, ano_fim)
    df_feriados = spark.createDataFrame([(d,) for d in feriados], ['data_feriado'])

    df = df.withColumn('_data_valida', F.to_date(F.col(coluna_data_origem), 'yyyy-MM-dd'))
    df = df.join(
        F.broadcast(df_feriados),
        F.col(coluna_data_origem) == F.col('data_feriado'),
        how='left',
    )

    dia_semana_num = F.dayofweek(F.col('_data_valida'))

    df = df.withColumn(
        f'{prefixo}_tipo_dia',
        F.when(F.col('_data_valida').isNull(), F.lit('indefinido'))
         .when(F.col('data_feriado').isNotNull(), F.lit('feriado'))
         .when(dia_semana_num == 1, F.lit('domingo'))
         .when(dia_semana_num == 6, F.lit('sexta'))
         .when(dia_semana_num == 7, F.lit('sabado'))
         .otherwise(F.lit('semana'))
    )

    return df.drop('_data_valida', 'data_feriado')


def calcular_data_exportacao():
    agora_brasil = datetime.now(ZoneInfo(TZ_NEGOCIO))
    if agora_brasil.hour < 4:
