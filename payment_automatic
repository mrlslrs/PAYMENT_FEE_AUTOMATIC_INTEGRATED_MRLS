def aguardar_planilha_completa(aba_brazil, total_linhas_esperadas, coluna_verificacao='C',
                                linha_inicial=2, intervalo_segundos=30, tempo_maximo_segundos=3600):
    tempo_decorrido = 0
    indice_col = _indice_coluna(coluna_verificacao)

    while tempo_decorrido < tempo_maximo_segundos:
        valores = aba_brazil.col_values(indice_col)
        linhas_preenchidas = max(0, len(valores) - (linha_inicial - 1))
        print(f"Linhas preenchidas: {linhas_preenchidas}/{total_linhas_esperadas} "
              f"(decorrido: {tempo_decorrido}s)")

        if linhas_preenchidas >= total_linhas_esperadas:
            print("Planilha completa.")
            return True

        time.sleep(intervalo_segundos)
        tempo_decorrido += intervalo_segundos

    print("Tempo maximo de espera atingido sem completar o preenchimento.")
    return False


def disparar_pagamento_appsheet(chaves_linhas, nome_action="ConfirmarPagamento"):
    url = f"https://{APPSHEET_REGION}/api/v2/apps/{APPSHEET_APP_ID}/tables/{APPSHEET_TABLE_NAME}/Action"

    payload = {
        "Action": nome_action,
        "Properties": {"Locale": "pt-BR"},
        "Rows": [{"Row ID": chave} for chave in chaves_linhas],
    }
    headers = {
        "ApplicationAccessKey": APPSHEET_ACCESS_KEY,
        "Content-Type": "application/json",
    }

    resposta = requests.post(url, json=payload, headers=headers, timeout=30)
    resposta.raise_for_status()
    return resposta.json()


