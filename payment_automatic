def enviar_documento_para_varios(caminho_pdf, nome_arquivo, legenda, destinatarios):

    with open(caminho_pdf, "rb") as arquivo:
        resposta_upload = requests.post(
            f"{BASE_URL}/media",
            headers=_headers(),
            files={"file": (nome_arquivo, arquivo, "application/pdf")},
            data={"messaging_product": "whatsapp", "type": "application/pdf"},
        )
    resposta_upload.raise_for_status()
    media_id = resposta_upload.json()["id"]
    print(f"Documento enviado para a Meta, media_id: {media_id}")

    resultados = []
    for papel, numero in destinatarios.items():
        payload = {
            "messaging_product": "whatsapp",
            "to": numero,
            "type": "document",
            "document": {"id": media_id, "filename": nome_arquivo, "caption": legenda},
        }
        try:
            resposta = requests.post(
                f"{BASE_URL}/messages",
                headers={**_headers(), "Content-Type": "application/json"},
                json=payload,
            )
            resposta.raise_for_status()
            print(f"  Enviado para {papel} ({numero})")
            resultados.append({"papel": papel, "numero": numero, "status": "enviado"})
        except requests.HTTPError as e:
            print(f"  Falhou para {papel} ({numero}): {e}")
            resultados.append({"papel": papel, "numero": numero, "status": "erro", "detalhe": str(e)})

    return resultados









