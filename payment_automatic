        str(r.get('execucao_id')) == str(execucao_id) and r.get('status') == 'enviado'
        for r in registros
    )


def registrar_checkpoint_execucao(aba_checkpoint, execucao_id, total_linhas, status, mensagem_erro=''):
    aba_checkpoint.append_row([
        execucao_id, total_linhas, status,
        datetime.now().strftime('%Y-%m-%d %H:%M:%S'), mensagem_erro,
    ], value_input_option='USER_ENTERED')


def enviar_com_retry(aba_brazil, ranges_e_dados, tentativas_max=5):
    ultimo_erro = None
    for tentativa in range(1, tentativas_max + 1):
        try:
            for range_name, valores in ranges_e_dados:
                aba_brazil.update(range_name, valores, value_input_option="USER_ENTERED")
            return True
        except Exception as e:
            ultimo_erro = e
            if tentativa == tentativas_max:
                break
            espera = 5 ** tentativa
            print(f"  Tentativa {tentativa}/{tentativas_max} falhou ({e}). "
                  f"Aguardando {espera}s antes de tentar de novo...")
            time.sleep(espera)
    raise ultimo_erro


