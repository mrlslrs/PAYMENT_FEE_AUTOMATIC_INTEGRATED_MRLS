def montar_tabela_html(resumo_lojas):
    linhas_html = "".join(
        f"<tr>"
        f"<td>{row['loja_id']}</td>"
        f"<td>{row['nome_loja']}</td>"
        f"<td style='text-align:right'>{row['Freelas']}</td>"
