def _converter_decimal_brasileiro(serie):
    return pd.to_numeric(
        serie.astype(str).str.replace('.', '', regex=False).str.replace(',', '.', regex=False),
        errors='coerce',
    )


def _ler_aba_pricing(sheet, nome_aba, nome_fonte):
    aba = sheet.worksheet(nome_aba)
    df = get_as_dataframe(aba, skiprows=2, usecols=range(len(COLUNAS_ORIGEM_PRICING)))
    df.columns = COLUNAS_ORIGEM_PRICING
    df['Fonte'] = nome_fonte
    return df


def consolidar_pricing(gc, planilha_pricing_id):
    sheet = gc.open_by_key(planilha_pricing_id)

    df_store = _ler_aba_pricing(sheet, 'store_pricing', 'store_pricing')
    df_lojas = _ler_aba_pricing(sheet, 'lojas', 'lojas')

    df_geral = pd.concat([df_store, df_lojas], ignore_index=True)

    for coluna in COLUNAS_NUMERICAS_PRICING:
        df_geral[coluna] = _converter_decimal_brasileiro(df_geral[coluna])

    df_geral = df_geral.sort_values('Base', ascending=False)

    def _primeiro_nao_vazio(serie):
        validos = serie.dropna()
        validos = validos[validos.astype(str).str.strip() != '']
        return validos.iloc[0] if len(validos) else None

    df_resolvido = (
        df_geral
        .groupby(['Brand ID', 'Store ID'], as_index=False)
        .agg({
            'Tipo': _primeiro_nao_vazio,
            'Modal': _primeiro_nao_vazio,
            'Brand': _primeiro_nao_vazio,
            'Nome': _primeiro_nao_vazio,
            **{c: 'first' for c in COLUNAS_NUMERICAS_PRICING},
        })
    )

    for coluna in COLUNAS_NUMERICAS_PRICING:
        df_resolvido[coluna] = df_resolvido[coluna].fillna(0.0)

    df_resolvido = df_resolvido.rename(columns={
        'Brand ID': 'marca_id',
        'Store ID': 'loja_id',
        'Brand': 'marca_nome_pricing',
        'Nome': 'nome_loja_pricing',
        'Base': 'qtd_base_semana',
        'Variavel': 'qtd_variavel_semana',
        'Base Sexta': 'qtd_base_sexta',
        'Variavel Sexta': 'qtd_variavel_sexta',
        'Base Sabado': 'qtd_base_sabado',
        'Variavel Sabado': 'qtd_variavel_sabado',
        'Base Domingo': 'qtd_base_domingo',
        'Variavel Domingo': 'qtd_variavel_domingo',
        'Base Feriado': 'qtd_base_feriado',
        'Variavel Feriado': 'qtd_variavel_feriado',
    })
    return df_resolvido.sort_values(['marca_id', 'loja_id']).reset_index(drop=True)


def _selecionar_colunas_pricing_por_dia(alias_tabela, dia_semana_col):
    variavel = (
        F.when(dia_semana_col == 'sexta', F.col(f'{alias_tabela}.qtd_variavel_sexta'))
         .when(dia_semana_col == 'sabado', F.col(f'{alias_tabela}.qtd_variavel_sabado'))
         .when(dia_semana_col == 'domingo', F.col(f'{alias_tabela}.qtd_variavel_domingo'))
         .when(dia_semana_col == 'feriado', F.col(f'{alias_tabela}.qtd_variavel_feriado'))
         .otherwise(F.col(f'{alias_tabela}.qtd_variavel_semana'))
    )
    base = (
        F.when(dia_semana_col == 'sexta', F.col(f'{alias_tabela}.qtd_base_sexta'))
         .when(dia_semana_col == 'sabado', F.col(f'{alias_tabela}.qtd_base_sabado'))
         .when(dia_semana_col == 'domingo', F.col(f'{alias_tabela}.qtd_base_domingo'))
         .when(dia_semana_col == 'feriado', F.col(f'{alias_tabela}.qtd_base_feriado'))
         .otherwise(F.col(f'{alias_tabela}.qtd_base_semana'))
    )
    return variavel, base


def calcular_pagamento_tarefas(df_tarefas, df_pricing, dia_semana_coluna='pedido_tipo_dia'):
    df_tarefas = df_tarefas.withColumn(
        'chave_loja_marca',
        F.concat(F.col('loja_id').cast('string'), F.col('marca_id').cast('string')),
    )
    df_pricing = df_pricing.withColumn(
        'chave_loja_marca',
        F.concat(F.col('loja_id').cast('string'), F.col('marca_id').cast('string')),
    )

    dia = F.col(f't.{dia_semana_coluna}')

    df = df_tarefas.alias('t').join(
        df_pricing.alias('sp'),
        F.col('t.chave_loja_marca') == F.col('sp.chave_loja_marca'),
        how='left',
    )

    variavel_sp, base_sp = _selecionar_colunas_pricing_por_dia('sp', dia)
    pagamento_bruto = variavel_sp * (F.col('t.quantidade_itens') - base_sp)

    df = df.withColumn(
        'pagamento_calculado',
        F.when(F.col('sp.chave_loja_marca').isNull(), F.lit('Brand/Store Não Encontrado'))
         .otherwise(F.greatest(pagamento_bruto, F.lit(0.0)) + F.coalesce(F.col('t.bonus_quantidade'), F.lit(0.0)))
    )

    df = df.withColumn(
        'descricao_pagamento',
        F.concat(
            F.lit('Pagamento por produto da tarefa: '), F.col('t.tarefa_id'),
            F.lit(' na loja: '), F.col('t.loja_id'), F.lit(' - '), F.col('t.loja_nome'),
            F.lit(' no dia: '), F.date_format(F.col('t.pedido_criado_em'), 'yyyy-MM-dd'),
        )
    )

    df = df.withColumn(
        'tipo_pagamento',
        F.when(F.col('t.marca_id') == BRAND_ID_BRAVANTE, F.lit(f'{NOME_BRAND_BRAVANTE} PACKING BR'))
         .when(
             (F.col('t.marca_id') == BRAND_ID_TROVAO) &
             (F.col('t.platforma') == SISTEMA_INTEGRADO_FICTICIO),
             F.lit(f'{NOME_BRAND_TROVAO} INTEGRADO'),
         )
         .when(F.col('t.marca_id') == BRAND_ID_TROVAO, F.lit(f'{NOME_BRAND_TROVAO} SEPARADOR'))
         .when(F.col('t.marca_nome') == f'{NOME_BRAND_TROVAO} ENTREGADOR', F.col('t.marca_nome'))
         .otherwise(F.col('sp.marca_nome_pricing'))
    )

    df = df.withColumn(
        'valor_final',
        F.when(F.col('pagamento_calculado') == 'Brand/Store Não Encontrado', F.lit('Brand/Store Não Encontrado'))
         .when(F.col('t.marca_id').isin(BRAND_IDS_SEM_SOMA), F.col('pagamento_calculado'))
         .otherwise(F.col('t.valor') + F.col('pagamento_calculado'))
    )

    df = df.withColumn('nome_loja_pricing', F.col('sp.nome_loja_pricing'))
    df = df.withColumn(
        'loja_validada',
        F.when(F.col('sp.chave_loja_marca').isNotNull(), F.col('t.loja_id')),
    )
    df = df.withColumn('categoria_pagamento', F.lit('Reward - Picking'))

    return df.drop('chave_loja_marca')


