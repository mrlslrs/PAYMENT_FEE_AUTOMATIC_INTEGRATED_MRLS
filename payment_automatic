def enviar_documento_whatsapp(caminho_pdf, nome_arquivo, numero_destinatario, legenda=""):
    with open(caminho_pdf, "rb") as arquivo:
        resposta_upload = requests.post(
            f"{BASE_URL}/media",
            headers=_headers(),
            files={"file": (nome_arquivo, arquivo, "application/pdf")},
            data={"messaging_product": "whatsapp", "type": "application/pdf"},
        )
    resposta_upload.raise_for_status()
    media_id = resposta_upload.json()["id"]
    print(f"Documento enviado para a Meta, media_id: {media_id}")

    payload = {
        "messaging_product": "whatsapp",
        "to": numero_destinatario,
        "type": "document",
        "document": {
            "id": media_id,
            "filename": nome_arquivo,
            "caption": legenda,
        },
    }
    resposta_envio = requests.post(
        f"{BASE_URL}/messages",
        headers={**_headers(), "Content-Type": "application/json"},
        json=payload,
    )
    resposta_envio.raise_for_status()
    resultado = resposta_envio.json()
    print(f"Mensagem enviada. ID: {resultado['messages'][0]['id']}")
    return resultado


